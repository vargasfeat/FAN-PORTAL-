# Copia este archivo como ".env" y ajusta los valores
PORT=3000

# Base de datos PostgreSQL
DB_HOST=aws-1-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.zpberrcqhmqogbatqvus
DB_PASSWORD=[PASSWORD]
# Activar en true si el servidor PostgreSQL remoto requiere SSL (obligatorio en Supabase)
DB_SSL=true
# Alternativa con cadena de conexion (recomendado para Supabase: usar Session/Transaction Pooler si no hay IPv6)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Llave para firmar las sesiones (JWT). Escribe una frase larga y aleatoria.
# Si la dejas vacia, las sesiones se cierran cada vez que reinicias el servidor.
JWT_SECRET=

# TheSportsDB: llave gratuita publica (v1). Con cuenta Premium, usa tu llave personal.
SPORTSDB_API_KEY=123

# Liga y club a mostrar en el Fan Portal
SPORTSDB_LEAGUE_ID=4627
TEAM_NAME=Colo-Colo
# Opcional pero recomendado con la llave gratuita: ID del club (el numero en la URL de su pagina en thesportsdb.com)
# TEAM_ID=

# Minutos que se guardan las respuestas en memoria (el plan gratuito permite 30 peticiones por minuto)
CACHE_TTL_MINUTES=10

# --- Solo para el servidor en produccion (cPanel) ---
# Direccion publica del backend (fija las URLs de las fotos). Ejemplo: https://api.midominio.cl
# PUBLIC_URL=
# Dominio(s) desde donde se abre la app web, separados por coma. Ejemplo: https://app.midominio.cl
# CORS_ORIGIN=
